        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Ref": "EC2InstanceRunningSchedulerRunningSchedulerFunctionAliaslive67072D6B",
          },
          "Input": "{"Params":{"TagKey":"WorkHoursRunning","TagValues":["YES"],"Mode":"Start"}}",
