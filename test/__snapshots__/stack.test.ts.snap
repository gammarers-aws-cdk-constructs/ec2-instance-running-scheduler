          "Version": "2012-10-17",
        },
        "Description": "Allows the running scheduler to describe instances, start/stop tagged EC2 instances, and send the configured notification.",
        "ManagedPolicyArns": [
          {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition",
                },
                ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
