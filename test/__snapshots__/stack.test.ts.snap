          },
          {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition",
                },
                ":iam::aws:policy/service-role/AWSLambdaBasicDurableExecutionRolePolicy",
              ],
            ],
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "EC2InstanceRunningSchedulerRunningSchedulerFunctionRoleDefaultPolicy567D5372": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "tag:GetResources",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "GetResources",
            },
            {
              "Action": "ec2:DescribeInstances",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "Ec2DescribeInstances",
            },
            {
              "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances",
              ],
              "Condition": {
                "StringEquals": {
                  "aws:ResourceTag/WorkHoursRunning": [
                    "YES",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":ec2:",
                    {
                      "Ref": "AWS::Region",
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":instance/*",
                  ],
                ],
              },
              "Sid": "Ec2StartStopTaggedInstances",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "EC2InstanceRunningSchedulerRunningSchedulerFunctionRoleDefaultPolicy567D5372",
        "Roles": [
          {
            "Ref": "EC2InstanceRunningSchedulerRunningSchedulerFunctionRole2BF102BB",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
